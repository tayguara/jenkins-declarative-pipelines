{
    "name": "example/sample-php-app",
    "description": "Sample PHP app used to exercise the Jenkins declarative pipeline.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true,
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "scripts": {
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-cobertura reports/coverage/cobertura.xml --coverage-crap4j reports/coverage/crap4j.xml",
        "audit:locked": "composer audit --locked",
        "mutation": "infection --min-msi=80 --min-covered-msi=90 --threads=max --show-mutations",
        "check": [
            "@cs",
            "@stan",
            "@audit:locked",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "cs": "Check code style (no changes written).",
        "cs:fix": "Fix code style in place.",
        "stan": "Run PHPStan at level max.",
        "test": "Run the PHPUnit suite.",
        "test:coverage": "Run PHPUnit with Cobertura and CRAP4J reports.",
        "audit:locked": "Audit locked dependencies for known advisories.",
        "mutation": "Run Infection mutation testing.",
        "check": "Run every gate except mutation testing."
    }
}
