# Copy to .env (git-ignored) and fill every value. Nothing here is a real secret.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=            # required, >= 16 chars, e.g. openssl rand -hex 24
DEPLOY_TOKEN_STAGING=              # required, >= 16 chars
DEPLOY_TOKEN_PRODUCTION=           # required, >= 16 chars, different from staging
REPO_URL=git://git-server/jenkins-declarative-pipelines.git
PIPELINE_BRANCH=demo               # 'main' when REPO_URL points to GitHub
JENKINS_HTTP_PORT=8080
WEB_STAGING_PORT=8081
WEB_PRODUCTION_PORT=8082
